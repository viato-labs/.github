# Jira Cloud (recommended for BA automation)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your.name@company.com
JIRA_API_TOKEN=

# Optional: force dry-run even when credentials exist
JIRA_DRY_RUN=true

# Defaults used when the BA does not specify them
JIRA_DEFAULT_PROJECT=PROJ
JIRA_DEFAULT_ISSUE_TYPE=Story
JIRA_GOLDEN_TICKET_KEY=

# Optional AI rewrite (leave empty for deterministic template filling)
# OPENAI_API_KEY=
