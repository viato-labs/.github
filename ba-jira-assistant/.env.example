# Path B — Atlassian OAuth (Sign in with Microsoft via Atlassian)
# Create an OAuth 2.0 (3LO) app at https://developer.atlassian.com/console/myapps/
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=http://localhost:3000/api/auth/atlassian/callback
APP_BASE_URL=http://localhost:3000

# Optional fallback API-token mode (rarely available in corporates)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your.name@company.com
JIRA_API_TOKEN=
JIRA_DRY_RUN=true

# Fallback defaults only (each company workspace has its own)
JIRA_DEFAULT_PROJECT=PROJ
JIRA_DEFAULT_ISSUE_TYPE=Story
JIRA_GOLDEN_TICKET_KEY=
