# Optional fallback single-tenant Jira credentials.
# Prefer per-company logins saved via the UI / POST /api/companies/credentials
# (stored under .data/workspaces/<slug>/secrets.json).
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your.name@company.com
JIRA_API_TOKEN=

# Optional: force dry-run even when fallback credentials exist
JIRA_DRY_RUN=true

# Fallback defaults only (each company workspace has its own)
JIRA_DEFAULT_PROJECT=PROJ
JIRA_DEFAULT_ISSUE_TYPE=Story
JIRA_GOLDEN_TICKET_KEY=

# Optional AI rewrite (leave empty for deterministic template filling)
# OPENAI_API_KEY=
